<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_feedback_form" model="ir.ui.view">
        <field name="name">sale.feedback.form</field>
        <field name="model">sale.feedback</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <form string="Sale Feedback">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="rating" readonly="1"/>
                        <field name="comment" readonly="1"/>
                        <field name="feedback_date" readonly="1"/>
                        <field name="sale_order_id" widget="many2one_avatar_user" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_feedback_tree" model="ir.ui.view">
        <field name="name">sale.feedback.tree</field>
        <field name="model">sale.feedback</field>
        <field name="arch" type="xml">
            <list string="Sale Feedbacks" create="False" default_order="feedback_date desc">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="rating"/>
                <field name="feedback_date"/>
            </list>
        </field>
    </record>

    <record id="action_sale_feedback" model="ir.actions.act_window">
        <field name="name">Sale Order Feedbacks</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.feedback</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your sale order feedbacks
            </p><p>
                Use these feedbacks to gather insights on your sale orders.
                Specify conditions and stages to streamline your sales workflow.
            </p>
        </field>
    </record>

    <!-- <record id="view_sale_order_form_inherit_feedback" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.feedback</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="inside">
                <field name="feedback_ids" readonly="1">
                    <list string="Feedbacks" default_order="feedback_date desc">
                        <field name="rating"/>
                        <field name="feedback_date"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record> -->

    <record id="view_res_user_feedback_graph" model="ir.ui.view">
        <field name="name">res.users.feedback.graph</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <graph string="Average Feedback by Salesperson" type="bar">
            <field name="name" type="row"/> 
            <field name="average_rating" type="measure" operator="avg"/>
            </graph>
        </field>
    </record>

    <record id="action_res_user_feedback_graph" model="ir.actions.act_window">
        <field name="name">Average Feedback Ratings</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">graph,list</field>
        <field name="type">ir.actions.act_window</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Analyze average feedback ratings by salesperson
            </p>
        </field>
    </record>


    <record id="view_res_user_form_inherit_feedback" model="ir.ui.view">
        <field name="name">res.users.form.inherit.feedback</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_simple_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mobile']" position="after">
                <field name="average_rating" readonly="1"/>
                <field name="feedback_ids" readonly="1" >
                    <list string="Feedbacks" default_order="feedback_date desc">
                        <field name="rating"/>
                        <field name="feedback_date"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <menuitem id="sale_order_feedbacks_menu"
            name="Sale Order Feedbacks"
            action="action_sale_feedback"
            parent="sale.menu_sale_report"
            sequence="999"/>

    <menuitem id="menu_res_users_feedback_graph"
            name="Average Feedback Ratings"
            parent="sale.menu_sale_report"
            action="action_res_user_feedback_graph"
            sequence="888"/>

</odoo>