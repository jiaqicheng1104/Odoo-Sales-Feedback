<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_portal_content_feedback_inherit" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[contains(@t-if,'user_id')]" position="after">
            <div class="position-relative flex-grow-1 ">
                <h6>
                    <small class="text-muted mb-3">
                        Leave a review
                    </small>
                </h6>
                <form t-attf-action="/my/orders/{{ sale_order.id }}/submit_feedback" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    
                    <div class="form-group mb-3">
                        <label for="rating" class="form-label">Rating</label>
                        <select class="form-select" name="rating" required="True">
                            <option value="">Select a rating</option>
                            <t t-foreach="[1,2,3,4,5]" t-as="star" t-key="star">
                                <option t-att-value="str(star)">
                                    <t t-esc="star"/> <t t-esc="'⭐' * star"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <textarea name="comment" 
                            class="form-control flex-grow-1" 
                            rows="4" 
                            placeholder="Write something..."
                            required="True">TEST</textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm">Submit Feedback</button>
                </form>

            </div>
        </xpath>
    </template>
</odoo>
